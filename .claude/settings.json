{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WOTR_ROOT=\"$CLAUDE_PROJECT_DIR\" \"$HOME/wotr-rule-index/rust/target/release/wotr-mcp\" hook",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WOTR_ROOT=\"$CLAUDE_PROJECT_DIR\" \"$HOME/wotr-rule-index/rust/target/release/wotr-mcp\" hook",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "120000"
  }
}

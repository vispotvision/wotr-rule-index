[Unit]
Description=WOTR humanizer: its own Ollama, four slots, so the system Ollama's models keep one slot and their big contexts
After=network.target

[Service]
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_MODELS=/var/lib/ollama
Environment=OLLAMA_NUM_PARALLEL=4
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_KEEP_ALIVE=3m
# the models belong to the system Ollama; this one must never prune them
Environment=OLLAMA_NOPRUNE=1
ExecStart=/usr/bin/ollama serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

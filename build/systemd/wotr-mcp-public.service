# wotr-mcp-public.service — the WOTR MCP from anywhere, and the key dashboard (Rust, since 2026-11-04)
#
# rust/target/release/wotr-mcp http: the MCP on 127.0.0.1:8765 and :8767, which Tailscale
# Funnel publishes as https://<machine>.<tailnet>.ts.net/ and /ro. Every request needs an
# enabled key's token (header Bearer <token>, or the path /t/<token>/mcp), and the key sets
# the tools it may call. The keys live in ~/.config/wotr/mcp_keys.json (0600); the first run
# imported the two old secrets (build/.mcp_token as "Main", full; build/.mcp_token_ro as
# "Read-only (friends)"), so no connector URL changed. The dashboard, where keys are made,
# edited, rotated and watched, is http://127.0.0.1:8790/ on this PC only, never funneled.
#
# This one unit replaced wotr-mcp-public (Python, full tools) and wotr-mcp-readonly (Python,
# /ro). Tools not yet ported run in one Python worker (build/mcp_worker.py) it starts itself.
# Rollback: ExecStart=/bin/bash %h/wotr-rule-index/build/py.sh build/mcp_server.py --http
# --token --ops --port 8765 --log build/mcp_public.log, plus the old readonly unit from git.
#
# NOT enabled by build/systemd_setup.sh: build/mcp_public_setup.sh enables it with the funnel.
# Build first: (cd rust && cargo build --release). Logs: build/mcp_public.log (--log below)
# and journalctl --user -u wotr-mcp-public.

[Unit]
Description=WOTR MCP (Rust): the Funnel route gated by named keys, and the key dashboard

[Service]
TimeoutStopSec=5
Type=simple
WorkingDirectory=%h/wotr-rule-index
EnvironmentFile=-%h/.config/wotr/env
Environment=PYTHONIOENCODING=utf-8
ExecStart=%h/wotr-rule-index/rust/target/release/wotr-mcp http --port 8765 --port 8767 --dash 8790 --log build/mcp_public.log
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target

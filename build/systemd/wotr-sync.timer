# wotr-sync.timer — was the hourly trigger of the scheduled task "WOTR wiki sync"
# (RepetitionInterval one hour, from logon). Fires wotr-sync.service on the hour.
#
#   systemctl --user list-timers wotr-sync.timer     # next and last run
#   systemctl --user start wotr-sync.service         # a run now, outside the hour
#   systemctl --user disable --now wotr-sync.timer   # stop the hourly run

[Unit]
Description=WOTR wiki autosave, every 15 minutes

[Timer]
OnCalendar=*:0/15

[Install]
WantedBy=timers.target

# WOTR — the one place machine-specific paths and secrets live on Linux.
# Copy to ~/.config/wotr/env (mode 600). Every shell script sources it
# (build/env.sh), every systemd unit loads it (EnvironmentFile=), and the
# Python tools read it through common.load_env() when a variable is not
# already in the environment — so the MCP server launched by Claude Desktop,
# a timer at 03:30, and a terminal all see the same values.
#
# One KEY=value a line, no spaces around '='. Not shell syntax, though it looks
# like it: three readers parse this file (systemd, build/env.sh, common.load_env)
# and they agree only on the plain form, so —
#   - no quotes needed, even round a path with a space; one matching pair is
#     stripped if you use them, so "" is the same as nothing
#   - full paths: ~ and $HOME are left alone by systemd (env.sh and the Python
#     tools expand a leading ~, so a unit still works, but write the full path)
#   - no backslashes: systemd reads them as escapes and a trailing one joins the
#     next line; the scripts keep them literally
#   - nothing after the value: a comment is a line of its own, starting with #
# Never commit this file; the values below are placeholders.

# --- secrets (paste from the password manager; never into a chat or a commit) ---
NOTION_TOKEN=
DISCORD_TOKEN=
ELEVENLABS_API_KEY=
HF_TOKEN=

# --- paths ---
# the repo (every script derives it from its own location; this is for the units)
WOTR_REPO=/home/oridon/wotr-rule-index
# the interpreter every step runs in (build/setup_linux.sh makes it)
WOTR_PYTHON=/home/oridon/.venvs/wotr/bin/python
# the 18 base craft guides and their dated editions (was Documents\WOTR True Canon)
WOTR_TRUE_CANON=/home/oridon/wotr-vault/true-canon
# where the TTS venvs live (was C:\venvs); each engine is <WOTR_VENVS>/wotr-<engine>
WOTR_VENVS=/home/oridon/.venvs
# Google Drive, if mounted (rclone mount gdrive: ~/GoogleDrive). Empty = the Drive
# exports are skipped and the backup goes to WOTR_BACKUP_DIR instead.
WOTR_DRIVE=
# local backups when Drive is not mounted (the weekly zip, last twelve kept)
WOTR_BACKUP_DIR=/home/oridon/wotr-backups

# --- switches (uncomment the KEY=value line as it stands; no text after the value) ---
# run the nightly numbers only, no overnight note
# WOTR_NIGHTLY_NO_CLAUDE=1
# the book dispatcher writes nothing
# WOTR_BOOK_OFF=1
# the funnel's base URL, for the public MCP server
# WOTR_MCP_PUBLIC_URL=https://ultron.tailf1bfa3.ts.net
